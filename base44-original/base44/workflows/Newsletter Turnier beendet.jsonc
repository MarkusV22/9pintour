{
  "name": "Newsletter: Turnier beendet",
  "description": "Sendet automatisch einen Ergebnis-Newsletter an alle Abonnenten, wenn ein Turnier auf 'abgeschlossen' gesetzt wird.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"abgeschlossen\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Tournament"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "newsletter_turnier_beendet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTournamentFinished",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTournamentFinished"
  }
}