{
  "name": "PlayerMerge",
  "type": "object",
  "properties": {
    "keep_player_id": {
      "type": "string",
      "description": "ID des erhaltenen (behaltenen) Spielers"
    },
    "remove_player_id": {
      "type": "string",
      "description": "ID des gel\u00f6schten/zusammengelegten Spielers"
    },
    "keep_player_name": {
      "type": "string",
      "description": "Name des erhaltenen Spielers"
    },
    "remove_player_name": {
      "type": "string",
      "description": "Name des gel\u00f6schten Spielers"
    },
    "keep_player_number": {
      "type": "number",
      "description": "Nummer des erhaltenen Spielers"
    },
    "remove_player_number": {
      "type": "number",
      "description": "Nummer des gel\u00f6schten Spielers"
    },
    "performed_by": {
      "type": "string",
      "description": "E-Mail des Admins der die Zusammenlegung durchgef\u00fchrt hat"
    },
    "is_repair": {
      "type": "boolean",
      "default": false,
      "description": "True wenn dies eine Reparatur einer verwaisten Referenz war (Spieler war bereits gel\u00f6scht)"
    }
  },
  "required": [
    "keep_player_id",
    "remove_player_id",
    "keep_player_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "turnier_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "turnier_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}