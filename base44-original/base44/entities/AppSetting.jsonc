{
  "name": "AppSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Einzigartiger Schl\u00fcssel der Einstellung (z.B. 'privacy_disclaimer_url')"
    },
    "value": {
      "type": "string",
      "description": "Wert der Einstellung (z.B. URL zum PDF)"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "turnier_admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "turnier_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "turnier_admin"
          }
        }
      ]
    }
  }
}